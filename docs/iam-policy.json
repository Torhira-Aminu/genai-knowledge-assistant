{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InvokeNovaMicroAndLiteViaUsInferenceProfiles",
      "Effect": "Allow",
      "Action": ["bedrock:InvokeModel"],
      "Resource": [
        "arn:aws:bedrock:*:*:inference-profile/us.amazon.nova-micro-v1:0",
        "arn:aws:bedrock:*:*:inference-profile/us.amazon.nova-lite-v1:0",
        "arn:aws:bedrock:*::foundation-model/amazon.nova-micro-v1:0",
        "arn:aws:bedrock:*::foundation-model/amazon.nova-lite-v1:0"
      ]
    },
    {
      "Sid": "ReadOnlyDiscoveryForCheckScript",
      "Effect": "Allow",
      "Action": ["bedrock:ListFoundationModels", "bedrock:ListInferenceProfiles"],
      "Resource": "*"
    }
  ]
}
